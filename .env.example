GITLAB_WEBHOOK_SECRET=your_webhook_secret_here
GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx

# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=synkron

# ── Service URLs ─────────────────────────────────────────────────────────────
# Local dev:   http://localhost:8080
# Production:  your deployed Cloud Run URL
SERVICE_URL=http://localhost:8080
INTERNAL_SECRET=random_long_secret_here

# ── Gemini API (direct 4-agent pipeline) ─────────────────────────────────────
GEMINI_API_KEY=AIzaSy_your_key_here

# ── ADK Agent Builder path (local runner, no Vertex AI cost) ─────────────────
# Set USE_AGENT_BUILDER=true to use the ADK + real GitLab MCP server path
# instead of the direct 4-agent REST pipeline.
#
# How it works:
#   1. The agent runs in-process (no cloud deployment needed).
#   2. It spawns npx @zereight/mcp-gitlab via stdio — needs Node.js installed.
#   3. Billed to GOOGLE_API_KEY (Gemini API free tier), not Vertex AI.
#
# Get GOOGLE_API_KEY from: https://aistudio.google.com/apikey
USE_AGENT_BUILDER=false
GOOGLE_API_KEY=AIzaSy_your_aistudio_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ── Google Cloud (only needed for Cloud Tasks queueing or Vertex AI deploy) ──
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=asia-south1
# Only fill this if you ran scripts/deploy_agent.py to deploy to Agent Engine:
AGENT_ENGINE_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID

# ── Local development only ───────────────────────────────────────────────────
# Bypasses Cloud Tasks — calls /internal/run-pipeline directly instead of
# enqueueing. NEVER set true in production.
LOCAL_DEV=true