GITLAB_WEBHOOK_SECRET=your_secret_here
GITLAB_PAT=glpat-xxxxxxxxxxxxxxxxxxxx
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=us-central1
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB_NAME=synkron

# Local dev: set to http://localhost:8080
# Production: set to your deployed Cloud Run URL
SERVICE_URL=http://localhost:8080

INTERNAL_SECRET=random_long_secret_string_here
GEMINI_API_KEY=AIzaSy_your_key_here
AGENT_ENGINE_RESOURCE=projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/YOUR_ENGINE_ID

# ── Local development only ───────────────────────────────────────────────────
# Set to true to skip Google Cloud Tasks and call internal endpoints directly.
# This lets you run the full pipeline locally with zero cloud setup.
# NEVER set this to true in production.
LOCAL_DEV=true